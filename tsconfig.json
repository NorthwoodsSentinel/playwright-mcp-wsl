{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": [
    "cli.js",
    "detect.js",
    "index.d.ts",
    "types/**/*.d.ts",
    "test/**/*.mjs",
    "scripts/**/*.mjs",
    "eslint.config.mjs",
    "vitest.config.mjs"
  ]
}
