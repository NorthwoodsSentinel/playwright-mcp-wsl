{
  "name": "playwright-mcp-wsl",
  "version": "1.0.0",
  "description": "Drop-in WSL-safe wrapper for @playwright/mcp. Prevents GPU crashes on Windows Subsystem for Linux by disabling Chromium GPU acceleration through the dxg bridge.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NorthwoodsSentinel/playwright-mcp-wsl.git"
  },
  "keywords": [
    "playwright",
    "mcp",
    "wsl",
    "wsl2",
    "claude-code",
    "browser-automation",
    "windows",
    "gpu-fix"
  ],
  "author": "Robert Chuvala <rob@northwoodssentinel.com>",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.index.json",
    "test": "vitest run --coverage && node scripts/verify-gate-scope.mjs",
    "local:gate": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "bin": {
    "playwright-mcp-wsl": "cli.js"
  },
  "main": "index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "dependencies": {
    "@playwright/mcp": ">=0.0.60"
  },
  "files": [
    "cli.js",
    "index.js",
    "index.d.ts",
    "wsl-config.json",
    "detect.js",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^5.5.0",
    "vitest": "^5.1.0"
  }
}
